rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // 1. Default Deny
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Bootstrapped admin: user email from runtime
      return isSignedIn() && (
        request.auth.token.email == 'richlamptey2004@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // 3. Validation Blueprints
    // -------------------------------------------------------------------------
    
    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'description', 'date', 'imageUrl', 'createdAt']) &&
             data.keys().hasOnly(['title', 'description', 'date', 'imageUrl', 'createdAt']) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
             data.description is string && data.description.size() >= 10 && data.description.size() <= 1000 &&
             data.date is string && // Simplified for date-time format check in rules
             data.imageUrl is string && data.imageUrl.size() <= 2048 &&
             data.createdAt == request.time;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['category', 'imageUrl', 'createdAt']) &&
             data.keys().hasOnly(['category', 'imageUrl', 'description', 'createdAt']) &&
             data.category in ['Classrooms', 'Labs', 'ICT', 'Playground', 'Events'] &&
             data.imageUrl is string && data.imageUrl.size() <= 2048 &&
             data.createdAt == request.time;
    }

    function isValidContent(data) {
      return data.keys().hasAll(['key', 'value', 'updatedAt']) &&
             data.keys().hasOnly(['key', 'value', 'updatedAt']) &&
             data.key is string && data.key.matches('^[a-zA-Z0-9_]+$') &&
             data.value is string && data.value.size() <= 5000 &&
             data.updatedAt == request.time;
    }

    // -------------------------------------------------------------------------
    // 4. Collection Rules
    // -------------------------------------------------------------------------

    match /events/{eventId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidEvent(incoming());
      allow update: if isAdmin() && isValidEvent(incoming());
      allow delete: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidGalleryItem(incoming());
      allow update: if isAdmin() && isValidGalleryItem(incoming());
      allow delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidContent(incoming());
      allow update: if isAdmin() && isValidContent(incoming());
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // Admins are managed via console or bootstrap
    }
  }
}
